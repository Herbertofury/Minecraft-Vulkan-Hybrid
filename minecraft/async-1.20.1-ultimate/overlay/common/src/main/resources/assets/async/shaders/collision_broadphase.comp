#version 450

layout(local_size_x = 64) in;

// 16 bytes. The final two words are reserved for future tuning without ABI churn.
layout(push_constant) uniform PushConstants {
    int entityCount;
    int maxPairs;
    float reservedFloat;
    int reservedInt;
};

// Six conservative AABB bounds. CPU upload rounds mins outward/down and maxes
// outward/up so float narrowing can produce false positives, never false negatives.
layout(std430, binding = 0) readonly buffer MinX { float minX[]; };
layout(std430, binding = 1) readonly buffer MinY { float minY[]; };
layout(std430, binding = 2) readonly buffer MinZ { float minZ[]; };
layout(std430, binding = 3) readonly buffer MaxX { float maxX[]; };
layout(std430, binding = 4) readonly buffer MaxY { float maxY[]; };
layout(std430, binding = 5) readonly buffer MaxZ { float maxZ[]; };

layout(std430, binding = 6) writeonly buffer PairsA   { int pairsA[]; };
layout(std430, binding = 7) writeonly buffer PairsB   { int pairsB[]; };
layout(std430, binding = 8) coherent buffer PairCount { int pairCounter; };

shared float shMinX[64];
shared float shMinY[64];
shared float shMinZ[64];
shared float shMaxX[64];
shared float shMaxY[64];
shared float shMaxZ[64];

void main() {
    uint gid = gl_GlobalInvocationID.x;
    bool active = gid < uint(entityCount);

    // Never return before a workgroup barrier. The final dispatched workgroup is
    // normally only partially occupied when entityCount is not divisible by 64;
    // inactive lanes still have to execute every barrier for Vulkan convergence.
    float myMinX = active ? minX[gid] : 0.0;
    float myMinY = active ? minY[gid] : 0.0;
    float myMinZ = active ? minZ[gid] : 0.0;
    float myMaxX = active ? maxX[gid] : 0.0;
    float myMaxY = active ? maxY[gid] : 0.0;
    float myMaxZ = active ? maxZ[gid] : 0.0;

    uint tileCount = (uint(entityCount) + 63u) / 64u;
    for (uint tile = 0u; tile < tileCount; ++tile) {
        uint localIdx = gl_LocalInvocationID.x;
        uint entityId = tile * 64u + localIdx;

        if (entityId < uint(entityCount)) {
            shMinX[localIdx] = minX[entityId];
            shMinY[localIdx] = minY[entityId];
            shMinZ[localIdx] = minZ[entityId];
            shMaxX[localIdx] = maxX[entityId];
            shMaxY[localIdx] = maxY[entityId];
            shMaxZ[localIdx] = maxZ[entityId];
        }
        barrier();

        if (active) {
            uint tileElemCount = min(64u, uint(entityCount) - tile * 64u);
            for (uint j = 0u; j < tileElemCount; ++j) {
                uint jId = tile * 64u + j;
                if (gid >= jId) continue;

                bool overlaps = myMinX < shMaxX[j] && myMaxX > shMinX[j]
                             && myMinY < shMaxY[j] && myMaxY > shMinY[j]
                             && myMinZ < shMaxZ[j] && myMaxZ > shMinZ[j];
                if (overlaps) {
                    int slot = atomicAdd(pairCounter, 1);
                    if (slot < maxPairs) {
                        pairsA[slot] = int(gid);
                        pairsB[slot] = int(jId);
                    }
                }
            }
        }
        barrier();
    }
}
