#version 450

// Diagnostic candidate only. This intentionally keeps the production descriptor
// and push-constant ABI while removing shared-memory tiling/barriers. It is a
// conservative O(n^2) GPU broad phase used to isolate the tiled shader from the
// otherwise identical Vulkan backend/data path.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    int entityCount;
    int maxPairs;
    float reservedFloat;
    int reservedInt;
};

layout(std430, binding = 0) readonly buffer MinX { float minX[]; };
layout(std430, binding = 1) readonly buffer MinY { float minY[]; };
layout(std430, binding = 2) readonly buffer MinZ { float minZ[]; };
layout(std430, binding = 3) readonly buffer MaxX { float maxX[]; };
layout(std430, binding = 4) readonly buffer MaxY { float maxY[]; };
layout(std430, binding = 5) readonly buffer MaxZ { float maxZ[]; };
layout(std430, binding = 6) writeonly buffer PairsA { int pairsA[]; };
layout(std430, binding = 7) writeonly buffer PairsB { int pairsB[]; };
layout(std430, binding = 8) coherent buffer PairCount { int pairCounter; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(entityCount)) {
        return;
    }

    float aMinX = minX[i];
    float aMinY = minY[i];
    float aMinZ = minZ[i];
    float aMaxX = maxX[i];
    float aMaxY = maxY[i];
    float aMaxZ = maxZ[i];

    for (uint j = i + 1u; j < uint(entityCount); ++j) {
        bool overlaps =
                aMinX < maxX[j] && aMaxX > minX[j] &&
                aMinY < maxY[j] && aMaxY > minY[j] &&
                aMinZ < maxZ[j] && aMaxZ > minZ[j];
        if (!overlaps) {
            continue;
        }

        int slot = atomicAdd(pairCounter, 1);
        if (slot < maxPairs) {
            pairsA[slot] = int(i);
            pairsB[slot] = int(j);
        }
    }
}
